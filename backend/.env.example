# Copy this file to `.env` in `backend/` and fill in real values.
# `.env` itself is gitignored -- never commit real secrets.

# Postgres connection string (Neon in production, local Postgres in dev).
# Sync driver (psycopg2) -- matches Alembic's default sync migration setup;
# no code in this skeleton does async DB I/O yet. Neon connection strings
# use `ssl=require` for the async driver -- use `sslmode=require` here instead.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/graphmind

# Secret used to sign/verify JWTs. Generate a long random value.
JWT_SECRET=changeme-generate-a-long-random-secret

# Minutes an access token remains valid after login (Story 1.4). Optional --
# defaults to 60 in code if unset.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email verification (Story 1.6). Whether POST /auth/login rejects an
# unverified account with a 403. Optional -- defaults to "true" (verified-
# only login) if unset. Set to "false" for local dev if you have no
# reachable mailbox/SMTP relay and don't want to copy links out of the
# console log.
REQUIRE_EMAIL_VERIFICATION=true

# Hours a verify-email link stays valid before the token in it expires.
# Optional -- defaults to 24 in code if unset.
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Outbound email for the verification message itself. All optional as a
# group: configure no transport at all and shared/email's send_email logs
# the recipient, subject, and full body (including the verify link) to
# the console instead of mailing it -- this is what local dev and the
# whole backend test suite run against, with zero mail configuration.
#
# TWO TRANSPORTS. BREVO_API_KEY wins if both are set (see send_email).
#
# 1. BREVO_API_KEY -- Brevo's HTTP API, over HTTPS on 443.
#
# REQUIRED IN PRODUCTION ON RENDER'S FREE TIER, which blocks outbound
# traffic on ports 25, 465 AND 587 -- every port SMTP uses. smtplib
# cannot deliver anything from there no matter how it is configured; the
# symptom is a silent non-delivery, since auth/service.py logs and
# swallows the send error so a failed email can't 500 a successful
# registration. An earlier version of this file claimed only port 25 was
# blocked. That was wrong, and it cost real debugging time.
#
# Brevo specifically (over Resend/SendGrid) because its free tier
# verifies a single SENDER ADDRESS -- a Gmail address, confirmed by
# clicking a link -- rather than requiring a whole authenticated domain,
# which this project does not own. 300 sends/day. Set SMTP_FROM to that
# verified address; the API rejects any other sender.
#
# Deliverability caveat: without domain authentication (SPF/DKIM on a
# domain you control), mail may land in spam for some recipients. Fine
# for a demo, not for anything real.
# BREVO_API_KEY=changeme
#
# 2. SMTP_* -- direct SMTP. Works locally and on any host that doesn't
# block the ports (Mailtrap for local/dev testing, or a real relay).
# Unusable on Render free, per above.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=changeme
# SMTP_PASSWORD=changeme
# Also used as the From address for the Brevo transport above, where it
# must match a sender address verified in the Brevo dashboard.
# SMTP_FROM=noreply@your-domain.example
# STARTTLS is on by default; set to "false" only for a relay that doesn't
# support it (e.g. some local dev catch-all SMTP servers).
# SMTP_STARTTLS=true

# Weaviate vector database (Story 2.3: passage embeddings for parsed
# documents). Required for the background ingestion task to succeed --
# without it, uploads still create the Uploaded row, but the background
# task marks the document Failed once it tries to write passages. Not
# required to run the backend test suite: documents-module tests replace
# `service.ingest_document` with a no-op (conftest.py's autouse
# `_stub_ingestion_pipeline`), and the dedicated ingestion tests
# (test_documents_parse_and_index.py) call the real function directly
# with a mocked `write_passages`.
#
# Weaviate also *computes* the embeddings now (text2vec-weaviate), not
# just stores them -- the app runs no embedding model of its own. So this
# cluster must be a Weaviate Cloud one with the Weaviate Embeddings
# service available; a self-hosted Weaviate does not offer that module,
# and pointing this at one would create the collection but fail to
# vectorize anything. The free tier includes 2,000 embedding
# requests/day, which is one per `PASSAGE_BATCH_SIZE` chunks ingested
# plus one per chat question.
WEAVIATE_URL=https://your-weaviate-cluster.weaviate.network
WEAVIATE_API_KEY=changeme

# Neo4j AuraDB graph database (entity/relationship graph, Story 2.4).
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# OpenRouter LLM provider (entity extraction, Story 2.4).
OPENROUTER_API_KEY=changeme

# Optional override for the extraction model. Leave unset to use
# `llm_client.DEFAULT_MODEL`, which is a free-tier slug.
#
# Set this if ingestion starts failing with a 404 whose message reads
# "This model is unavailable for free" -- OpenRouter withdraws free slugs
# without notice (it has already done so twice, to two earlier defaults), and
# swapping the value here is the intended fix rather than a code change.
# Pick a replacement from https://openrouter.ai/models?max_price=0 that
# lists `response_format` under its supported parameters; verify it returns
# `entities` as objects (some free models return bare strings, which this
# app correctly drops, leaving an empty graph).
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional override for the chat-answer model (Story 3.1) -- independent of
# OPENROUTER_MODEL above, which only affects entity extraction. Leave unset
# to use the same `llm_client.DEFAULT_MODEL` free-tier slug.
#
# NFR-1 (p95 chat latency < 8s) is knowingly NOT met by the default slug --
# a real call took ~32s even for a short prompt, against a 45s/attempt,
# 2-attempt budget (shared/llm_client's _CHAT_TIMEOUT_SECONDS), so a
# worst-case chat request can take up to ~120s. Setting this to a faster
# free (or paid) model is the actual fix; see the same guidance as
# OPENROUTER_MODEL above for picking a `response_format`-compatible
# replacement.
# OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional override for the question-routing model (Story 3.5) -- the
# intent-classification/query-rewrite call `resolve_question` makes before
# every chat answer. Independent of OPENROUTER_MODEL/OPENROUTER_CHAT_MODEL
# above. Leave unset to fall back to OPENROUTER_CHAT_MODEL, then to
# `llm_client.DEFAULT_MODEL`.
#
# This call sits in front of every real answer and is never retried
# (shared/llm_client's _ROUTER_TIMEOUT_SECONDS), so it is the best
# candidate in this file for a genuinely fast/small free model -- pick one
# from https://openrouter.ai/models?max_price=0 that returns clean JSON for
# a short classification prompt; a slower model here adds latency to every
# question for no benefit (a routing failure already degrades gracefully
# to the pre-3.5 factual flow, so there is no correctness reason to prefer
# a slower/larger model).
# OPENROUTER_ROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Origin of the frontend dev server, for CORS. Defaults to the Vite default.
FRONTEND_ORIGIN=http://localhost:5173

# Which immediate TCP peer(s) to trust an incoming X-Forwarded-For header
# from, for recovering the real client IP behind a reverse proxy (used by
# the login/register rate limiters). Defaults to "127.0.0.1" (nothing
# trusted) if unset -- deliberately inert for local dev.
#
# Render does not publish a stable IP/CIDR for its edge proxy, so there is
# no specific address to put here -- "*" is the only practical value once
# deployed. Left at the default in production, request.client.host is
# always the proxy's own IP for every caller, which degrades login back to
# its old per-email lockout risk and turns register's IP-only key into a
# single shared 5-per-60s budget for the *entire site*. But do NOT set "*"
# without first confirming (current Render docs at deploy time -- this can
# change) that a Web Service's container has no direct public port and is
# reachable only through Render's own routing layer; otherwise anyone
# connecting directly can spoof X-Forwarded-For and defeat the rate
# limiters entirely, which is worse than the unset default. This is a
# required deploy-checklist step, not a fire-and-forget default -- see
# _bmad-output/implementation-artifacts/deferred-work.md.
TRUSTED_PROXY_HOSTS=127.0.0.1

# Story 6.2's cross-tenant isolation proof (`scripts/isolation_proof.py`)
# drives the real API with real logins for two real QA accounts -- unlike
# every other script in this repo, it needs an actual password, not just a
# DB lookup. ISOLATION_QA1_PASSWORD is Account A's real password (the
# existing QA account, essinkabg@gmail.com -- same account eval_harness.py
# reuses). ISOLATION_QA2_PASSWORD is the password for a second, permanent,
# git-documented QA account (essinkabg+qa2@gmail.com) that the script
# registers on its own first run and never deletes. Both required for the
# script to run at all; see its own module docstring for why Account A's
# var isn't literally named in the spec (every earlier script only ever
# needed A by direct DB lookup, never a real login).
ISOLATION_QA1_PASSWORD=changeme
ISOLATION_QA2_PASSWORD=changeme
