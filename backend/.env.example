# Copy this file to `.env` in `backend/` and fill in real values.
# `.env` itself is gitignored -- never commit real secrets.

# Postgres connection string (Neon in production, local Postgres in dev).
# Uses the async driver (asyncpg) -- SQLAlchemy's async engine, once a
# story starts using it, expects this scheme.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/graphmind

# Secret used to sign/verify JWTs. Generate a long random value.
JWT_SECRET=changeme-generate-a-long-random-secret

# Weaviate vector database (not used yet -- Story 1.1 adds no real calls).
WEAVIATE_URL=https://your-weaviate-cluster.weaviate.network
WEAVIATE_API_KEY=changeme

# Neo4j AuraDB graph database (not used yet -- Story 1.1 adds no real calls).
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# OpenRouter LLM provider (not used yet -- Story 1.1 adds no real calls).
OPENROUTER_API_KEY=changeme

# Origin of the frontend dev server, for CORS. Defaults to the Vite default.
FRONTEND_ORIGIN=http://localhost:5173
