DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<pooled-host>/<db>?ssl=require
DATABASE_URL_DIRECT=postgresql+asyncpg://<user>:<pass>@<direct-host>/<db>?ssl=require
JWT_SECRET=<random 32+ byte string, напр. openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440


OPENROUTER_API_KEY=<paste your OpenRouter API key here>
